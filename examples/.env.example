# Lascia vuoto per far arrivare il token da "?api=<token>" nell'URL del
# webhook (più bot, stesso .env/codice) — vedi README, sezione "Più bot,
# stesso codice".
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_API_ENDPOINT=https://api.telegram.org/bot
TELEGRAM_WEBHOOK_SECRET=cambia-questa-stringa-a-caso-lunga
TELEGRAM_UPDATE_MODE=polling
# Simboli che attivano il routing dei comandi, separati da virgola (es: /,.,#).
# Se metti spazi dopo le virgole e usi "#", racchiudi il valore tra doppi apici
# (es: COMMAND_PREFIXES="/, ., #"), altrimenti "#" viene letto come un commento.
COMMAND_PREFIXES=/,.,#
# ID utente Telegram (numerici) amministratori del bot, separati da virgola.
# Usati da /ban in examples/updates/message.php ($bot->admins->isAdmin(...)).
ADMINS=
TELEGRAM_ALLOWED_IP_CHECK=false
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_LOG_LEVEL=critical

DB_DRIVER=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_DEBUG=true
APP_LOG_PATH=var/bot.log

RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_CHAT_PER_SECOND=1
RATE_LIMIT_GROUP_PER_MINUTE=20
