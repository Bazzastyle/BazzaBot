# Credenziali del bot Telegram (da @BotFather).
# Lascia TELEGRAM_BOT_TOKEN vuoto se più bot condividono questo stesso .env e
# lo stesso codice (secret/DB/rate limit comuni): in quel caso il token va
# passato per ogni richiesta come "?api=<token>" nell'URL del webhook (vedi
# examples/bootstrap.php e la sezione "Più bot, stesso codice" nel README).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_API_ENDPOINT=https://api.telegram.org/bot

# Segreto inviato da Telegram nell'header X-Telegram-Bot-Api-Secret-Token.
# Genera una stringa lunga e casuale, es: php -r "echo bin2hex(random_bytes(32));"
TELEGRAM_WEBHOOK_SECRET=cambia-questa-stringa-a-caso-lunga

# webhook oppure polling
TELEGRAM_UPDATE_MODE=polling

# Simboli che attivano il routing dei comandi (Router::command()), separati da virgola,
# SENZA spazi prima di un eventuale "#" (altrimenti il parser .env lo interpreta come
# inizio di un commento e tronca il valore). Se preferisci gli spazi, metti tutto tra
# doppi apici: COMMAND_PREFIXES="/, ., #".
# Esempi comuni: "/" (comandi Telegram standard), "." o "#" per pseudo-comandi testuali.
# Puoi combinarli, es: COMMAND_PREFIXES=/,.,#  -> "/ban", ".ban" e "#ban" attivano lo stesso handler.
COMMAND_PREFIXES=/

# Abilita la verifica dell'IP sorgente contro l'allowlist ufficiale Telegram (solo webhook)
TELEGRAM_ALLOWED_IP_CHECK=false

# ID utente Telegram (numerici) considerati amministratori del bot, separati da
# virgola (es: ADMINS=111111111,222222222). Verificali con Bazzastyle\BazzaBot\Auth\AdminList
# ($bot->admins->isAdmin($context->update->getFromId())). Vuoto = nessun amministratore.
ADMINS=

# Chat dove inviare i log di livello >= TELEGRAM_LOG_LEVEL (opzionale, lascia vuoto per disabilitare)
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_LOG_LEVEL=critical

# Database (opzionale: lascia DB_DRIVER vuoto per non inizializzare alcuna connessione)
DB_DRIVER=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

APP_DEBUG=false
APP_LOG_PATH=var/bot.log
APP_TIMEZONE=UTC

RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_CHAT_PER_SECOND=1
RATE_LIMIT_GROUP_PER_MINUTE=20
